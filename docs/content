    {
    "id": "engineParticipation",
    "label": "Engine Participation Count",
    "meaning": "How many distinct win engines / infrastructure loops this species can meaningfully participate in across common Champions doubles architectures, rather than within only one team.",
    "scale": "0-5"
    },
    {
    "id": "engineExclusivityTax",
    "label": "Engine Exclusivity Tax",
    "meaning": "How often teammates must become dedicated servants for this species to function. High tax means packages collapse around it; low tax means many packages can support it lightly.",
    "scale": "0-5 (higher = worse / more exclusive)"
    },
    {
    "id": "bridgeQuality",
    "label": "Bridge Quality",
    "meaning": "How effectively this species participates in separate modules without forcing either module to compromise.",
    "scale": "0-5"
    },
    {
    "id": "createFanOut",
    "label": "Create Fan-Out",
    "meaning": "How many strategically distinct teammate roles can consume what this species creates.",
    "scale": "0-5"
    },
    {
    "id": "convertFanOut",
    "label": "Convert Fan-Out",
    "meaning": "How many distinct infrastructure forms this species can convert into progress, such as weather, Tailwind, Fake Out turns, terrain, Intimidate turns, screens, Trick Room, redirection, or free setup turns.",
    "scale": "0-5"
    },
    {
    "id": "mag",
    "label": "MAG",
    "meaning": "Marginal Architecture Gain — how much genuinely new strategic territory this species tends to open on Champions doubles sixes at species baseline rather than in one specific six.",
    "scale": "0-5"
    },
    {
    "id": "moduleElasticity",
    "label": "Module Elasticity Support",
    "meaning": "As a root or key module, how many strategically different packages it can support without rebuilding the six.",
    "scale": "0-5"
    },
    {
    "id": "engineConverterContinuity",
    "label": "Engine-Converter Continuity",
    "meaning": "How effectively this species can create a favorable resource or state and later personally convert that same state into damage, control, scaling, or a win condition instead of requiring another dedicated converter.",
    "scale": "0-5"
    }
    ],
    "teamContextRules": {
    "cMagHint": "Start with species-baseline MAG, then inspect the five teammates for duplicated territory. Raise C-MAG when the candidate adds a genuinely new engine, failure condition, speed state, damage axis, counterplay inversion, Mega package, or conversion route that existing teammates can also exploit. Lower C-MAG when it merely strengthens an already-saturated route without creating a meaningfully different package or failure state.",
    "exclusivityGivenSix": "Lower Engine Exclusivity Tax when the other five already provide the infrastructure this species wants while remaining useful in unrelated packages. Lower it further when the species can function autonomously after consuming that infrastructure. Raise it when several teammates must change moves, items, Mega choice, positioning, speed profiles, or normal roles primarily to enable this species. Shared infrastructure with multiple consumers lowers tax; dedicated servants raise it.",
    "saturation": "Adding another member of the same archetype lowers C-MAG when both create or consume the same resources, compete for the same setup or Mega turn, fail to the same counterplay, or improve the same packages without opening new ones. Functional redundancy remains valuable when the new species converts shared infrastructure differently, creates another speed or damage state, supplies a different endgame, or turns the first route's counterplay into progress for a second route."
    },
